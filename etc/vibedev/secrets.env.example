# VibeDev AI 助手的密钥（docker run --env-file / compose env_file 使用）。
# 这里只有占位符：复制到仓库之外（例如 /srv/vibedev-ai-bot/secrets.env，权限 600）再填写，不要提交真实值。

# 机器人账号 @vibedev-ai 的口令
BAIBOT_USER_PASSWORD=__BOT_ACCOUNT_PASSWORD__

# 加密密钥备份/恢复口令（设定后不要再改）
BAIBOT_USER_ENCRYPTION_RECOVERY_PASSPHRASE=__LONG_RANDOM_PASSPHRASE__

# 会话加密密钥：openssl rand -hex 32
BAIBOT_PERSISTENCE_SESSION_ENCRYPTION_KEY=__64_HEX_CHARACTERS__

# 配置加密密钥（各群 API Key 的加密密钥，务必备份）：openssl rand -hex 32
BAIBOT_PERSISTENCE_CONFIG_ENCRYPTION_KEY=__64_HEX_CHARACTERS__

# 内部配置接口的共享密钥（集成中心后端用同一个值）：openssl rand -hex 32
BAIBOT_VIBEDEV_INTERNAL_API_SECRET=__AT_LEAST_32_CHARACTERS__
